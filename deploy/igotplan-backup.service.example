[Unit]
Description=Back up I GOT PLAN data
After=igotplan.service

[Service]
Type=oneshot
# Replace the project and Node.js paths before installing this service.
WorkingDirectory=/absolute/path/to/IGOTPLAN
ExecStart=/absolute/path/to/node /absolute/path/to/IGOTPLAN/scripts/data.js backup
# Create this file with BACKUP_DEST=/absolute/path/on/independent/storage
EnvironmentFile=%h/.config/igotplan/backup.env
Environment=API_URL=http://127.0.0.1:8000
UMask=0077
TimeoutStartSec=60
