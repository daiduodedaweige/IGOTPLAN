[Unit]
Description=Back up I GOT PLAN data
After=igotplan.service

[Service]
Type=oneshot
WorkingDirectory=/nfs/home/weijing/workspace/IGOTPLAN
ExecStart=/nfs/home/weijing/.nvm/versions/node/v24.15.0/bin/node /nfs/home/weijing/workspace/IGOTPLAN/scripts/data.js backup
# Create this file with BACKUP_DEST=/absolute/path/on/independent/storage
EnvironmentFile=%h/.config/igotplan/backup.env
Environment=API_URL=http://127.0.0.1:8000
UMask=0077
TimeoutStartSec=60
