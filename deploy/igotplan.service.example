[Unit]
Description=I GOT PLAN task board
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Replace the project and Node.js paths before installing this service.
WorkingDirectory=/absolute/path/to/IGOTPLAN
ExecStart=/absolute/path/to/node /absolute/path/to/IGOTPLAN/server.js
Environment=HOST=127.0.0.1
Environment=PORT=8000
Environment=DATA_DIR=/absolute/path/to/IGOTPLAN/data
Environment=BACKUP_KEEP=30
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=igotplan

[Install]
WantedBy=default.target
